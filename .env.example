# Supabase → Project Settings → API. The anon key is safe in the browser; RLS protects data.
# Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public address of this site, used in QR codes and review links.
NEXT_PUBLIC_SITE_URL=https://team.alliancesquare.com
